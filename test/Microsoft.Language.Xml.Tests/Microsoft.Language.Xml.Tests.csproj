<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Language.Xml.Tests</AssemblyName>
    <!--
      Both of the library's targets, so the netstandard2.0 build is covered too: it compiles a
      different branch of the entity decoder and runs against a different BCL, and until now
      nothing ever ran it.
    -->
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <!-- net472 would otherwise default to C# 7.3, which the tests are not written in. -->
    <LangVersion>latest</LangVersion>
    <!--
      Annotations only: the tests read a nullable-annotated API and say so in their own
      declarations, but they are not themselves held to the null analysis the library is.
    -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\key.snk</AssemblyOriginatorKeyFile>
    <DelaySign>False</DelaySign>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.1" />
    <PackageReference Include="xunit.runner.console" Version="2.4.1" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Microsoft.Language.Xml\Microsoft.Language.Xml.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="TestXml.xml" />
  </ItemGroup>
  <ItemGroup>
    <XunitTest_Xml Include="$(OutputPath)\TestResult.xml" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(XunitConsolePath)')">
    <XunitConsoleDirectory>$([System.IO.Path]::GetDirectoryName('$(XunitConsolePath)'))</XunitConsoleDirectory>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(XunitConsoleDirectory)\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Visible>False</Visible>
    </None>
  </ItemGroup>
</Project>